<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ THÊM PERMISSIONS NÀY ============ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="DatDoUongPromac2"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DatDoUongProMac2"
        tools:targetApi="31">

        <!-- LoginActivity là entry point chính -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity phải exported=true -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:parentActivityName=".auth.LoginActivity"/>

        <activity
            android:name=".cart.CartActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".order.OrderActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".admin.StatisticsActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".admin.AdminActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".promo.PromotionActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".promo.AdminPromotionActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".admin.UserManagementActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".user.ProfileActivity"
            android:exported="false" />

    </application>

</manifest>
